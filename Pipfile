[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
format = "python -m scripts.formatter"
console = "python -m SmartStitchConsole"
gui = "python -m SmartStitchGUI"
build = "python -m scripts.build"
build-no-icon = "python -m scripts.build"

[packages]
natsort = "*"
pillow = ">=12.2.0"
pillow-avif-plugin = "*"
cairosvg = "*"
numpy = "*"
pyside6 = "*"
pyqtdarktheme = "*"
psd-tools = ">=1.12.2"

[dev-packages]
flake8 = "*"
black = "*"
isort = "*"
pyinstaller = "*"

[requires]
python_version = "3.11"
